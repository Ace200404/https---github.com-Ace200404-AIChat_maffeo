@"
# Environment — NEVER commit this
.env

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Data files — transcripts can be large
data/raw/*.json

# IDE
.vscode/
.idea/

# macOS
.DS_Store

# Streamlit
.streamlit/

# Chainlit
chainlit.md
.chainlit/

# Logs
*.log
"@ | Out-File -FilePath .gitignore -Encoding utf8